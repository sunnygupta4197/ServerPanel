# ServerPanel Pro - Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
PORT=3000
APP_NAME="ServerPanel Pro"
APP_VERSION=1.0.0

# ===========================================
# SECURITY SETTINGS
# ===========================================
# Generate strong secrets for production!
JWT_SECRET=your_super_secure_jwt_secret_change_in_production_minimum_32_chars
SESSION_SECRET=your_super_secure_session_secret_change_in_production_minimum_32_chars
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX=100        # Max requests per window
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000       # 15 minutes in milliseconds

# Password requirements
PASSWORD_MIN_LENGTH=8

# ===========================================
# DATABASE SETTINGS
# ===========================================
# Choose your database: sqlite3, mysql, or postgresql
DB_CLIENT=mysql

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=serverpanel
DB_PASSWORD=secure_database_password_change_me
DB_NAME=serverpanel

# PostgreSQL Configuration (if using postgres)
# DB_CLIENT=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=serverpanel
# DB_PASSWORD=secure_postgres_password_change_me
# DB_NAME=serverpanel

# SQLite Configuration (if using sqlite3)
# DB_CLIENT=sqlite3
# DB_FILE=./data/serverpanel.db

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===========================================
# REDIS SETTINGS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me
REDIS_DB=0

# ===========================================
# EMAIL SETTINGS
# ===========================================
# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=smtp_password_change_me
EMAIL_FROM=ServerPanel Pro <noreply@yourdomain.com>

# ===========================================
# FILE UPLOAD SETTINGS
# ===========================================
MAX_FILE_SIZE=100MB
UPLOAD_PATH=./uploads
TEMP_PATH=/tmp/serverpanel

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.txt,.log,.conf,.json,.xml,.yml,.yaml,.js,.css,.html,.php,.py,.sh,.sql,.md

# ===========================================
# SYSTEM PATHS
# ===========================================
# Web server document root
WEB_ROOT=/var/www/html

# Log directories
LOGS_PATH=./logs
SYSTEM_LOG_DIR=/var/log
BACKUPS_PATH=./backups
CONFIGS_PATH=./configs
CERTS_PATH=./certificates

# Apache/Nginx configuration paths
APACHE_CONFIG=/etc/apache2/apache2.conf
NGINX_CONFIG=/etc/nginx/nginx.conf

# Service manager (systemd, windows, or sysv)
SERVICE_MANAGER=systemd

# ===========================================
# MONITORING SETTINGS
# ===========================================
MONITOR_INTERVAL=30000    # 30 seconds
MONITOR_RETENTION=30      # 30 days
ALERTS_ENABLED=true

# System thresholds for alerts
CPU_THRESHOLD=80.0        # CPU usage percentage
MEMORY_THRESHOLD=85.0     # Memory usage percentage
DISK_THRESHOLD=90.0       # Disk usage percentage
LOAD_THRESHOLD=5.0        # Load average threshold

# ===========================================
# BACKUP SETTINGS
# ===========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM (cron format)
BACKUP_RETENTION=7        # Keep backups for 7 days
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# ===========================================
# LOGGING SETTINGS
# ===========================================
LOG_LEVEL=info            # error, warn, info, debug
LOG_MAX_SIZE=10m          # Maximum log file size
LOG_MAX_FILES=5           # Number of log files to keep
LOG_CONSOLE=true          # Log to console
LOG_FILE=true             # Log to file

# ===========================================
# FRONTEND SETTINGS
# ===========================================
FRONTEND_URL=http://localhost:3000
DEFAULT_THEME=dark        # dark, light, auto
DEFAULT_LANGUAGE=en       # en, es, fr, de, etc.

# ===========================================
# API SETTINGS
# ===========================================
API_DOCS=true             # Enable API documentation
API_RATE_LIMIT=1000       # API requests per hour per key

# ===========================================
# FEATURE TOGGLES
# ===========================================
# Enable/disable features
FEATURE_FILE_MANAGER=true
FEATURE_DATABASE=true
FEATURE_SERVICES=true
FEATURE_MONITORING=true
FEATURE_BACKUP=true
FEATURE_USERS=true
FEATURE_EMAIL=true
FEATURE_SSL=true
FEATURE_DOMAINS=true

# ===========================================
# SSL/TLS SETTINGS
# ===========================================
SSL_ENABLED=false
SSL_CERT_PATH=./certificates/cert.pem
SSL_KEY_PATH=./certificates/key.pem
SSL_CA_PATH=./certificates/ca.pem

# Let's Encrypt settings
ACME_EMAIL=admin@yourdomain.com
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# ===========================================
# DOCKER SPECIFIC SETTINGS
# ===========================================
# MySQL root password (for Docker)
MYSQL_ROOT_PASSWORD=mysql_root_password_change_me

# PostgreSQL password (for Docker)
POSTGRES_PASSWORD=postgres_password_change_me

# Grafana admin password
GRAFANA_PASSWORD=grafana_admin_password_change_me

# Roundcube database password
ROUNDCUBE_PASSWORD=roundcube_password_change_me

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Only used in development mode
DEV_AUTO_RELOAD=true
DEV_DEBUG_ROUTES=false
DEV_MOCK_EMAIL=true
DEV_BYPASS_AUTH=false

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Webhook URLs for notifications
WEBHOOK_SLACK=
WEBHOOK_DISCORD=
WEBHOOK_TEAMS=

# Cloud storage settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Backup destinations
BACKUP_S3_ENABLED=false
BACKUP_FTP_ENABLED=false
BACKUP_SFTP_ENABLED=false

# ===========================================
# SECURITY HEADERS
# ===========================================
# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ===========================================
# PERFORMANCE SETTINGS
# ===========================================
# Node.js memory limits
NODE_OPTIONS=--max-old-space-size=2048

# Compression settings
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Cache settings
CACHE_TTL=3600            # 1 hour in seconds
STATIC_CACHE_TTL=86400    # 24 hours for static files

# ===========================================
# TIMEZONE AND LOCALE
# ===========================================
TZ=UTC
LOCALE=en_US.UTF-8

# ===========================================
# ADVANCED SETTINGS
# ===========================================
# Worker processes (for clustering)
WORKERS=auto              # 'auto' or number of workers

# Request timeout
REQUEST_TIMEOUT=30000     # 30 seconds

# Keep-alive timeout
KEEP_ALIVE_TIMEOUT=5000   # 5 seconds

# Body parser limits
JSON_LIMIT=50mb
URL_ENCODED_LIMIT=50mb

# ===========================================
# MAINTENANCE MODE
# ===========================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="ServerPanel Pro is currently under maintenance. Please try again later."

# ===========================================
# CUSTOM BRANDING
# ===========================================
BRAND_NAME="ServerPanel Pro"
BRAND_LOGO=/assets/logo.png
BRAND_FAVICON=/assets/favicon.ico
BRAND_PRIMARY_COLOR=#3B82F6
BRAND_SECONDARY_COLOR=#1F2937