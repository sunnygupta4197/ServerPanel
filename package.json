{
  "name": "serverpanel-pro",
  "version": "1.0.0",
  "description": "Professional server management panel with comprehensive monitoring and administration tools",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "seed:make": "knex seed:make",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset": "npm run migrate:rollback && npm run migrate && npm run seed",
    "docker:build": "docker build -t serverpanel-pro .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "health": "node scripts/health-check.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "docs": "jsdoc src/ -d docs/",
    "deploy": "bash scripts/deploy.sh",
    "deploy:prod": "NODE_ENV=production bash scripts/deploy.sh",
    "precommit": "npm run lint && npm run test",
    "prepare": "husky install"
  },
  "keywords": [
    "server",
    "management",
    "panel",
    "monitoring",
    "administration",
    "dashboard",
    "system",
    "nodejs",
    "express",
    "mysql",
    "redis",
    "docker"
  ],
  "author": {
    "name": "ServerPanel Pro Team",
    "email": "support@serverpanel.pro",
    "url": "https://serverpanel.pro"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/serverpanel/serverpanel-pro.git"
  },
  "bugs": {
    "url": "https://github.com/serverpanel/serverpanel-pro/issues"
  },
  "homepage": "https://serverpanel.pro",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.8.1",
    "morgan": "^1.10.0",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.1",
    "knex": "^2.5.1",
    "mysql2": "^3.6.0",
    "sqlite3": "^5.1.6",
    "pg": "^8.11.1",
    "redis": "^4.6.7",
    "winston": "^3.9.0",
    "express-winston": "^4.2.0",
    "socket.io": "^4.7.2",
    "multer": "^1.4.5-lts.1",
    "archiver": "^5.3.1",
    "unzipper": "^0.10.14",
    "node-cron": "^3.0.2",
    "systeminformation": "^5.21.7",
    "nodemailer": "^6.9.3",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "joi": "^17.9.2",
    "axios": "^1.4.0",
    "sharp": "^0.32.1",
    "pm2": "^5.3.0",
    "chokidar": "^3.5.3",
    "fs-extra": "^11.1.1",
    "tar": "^6.1.15",
    "glob": "^10.3.3",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "boxen": "^5.1.2",
    "update-notifier": "^5.1.0",
    "semver": "^7.5.4",
    "cross-env": "^7.0.3",
    "yargs": "^17.7.2",
    "debug": "^4.3.4",
    "https-proxy-agent": "^7.0.1",
    "ws": "^8.13.0",
    "jimp": "^0.22.10",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "connect-redis": "^7.1.0",
    "ioredis": "^5.3.2",
    "bull": "^4.10.4",
    "agenda": "^5.0.0",
    "shelljs": "^0.8.5",
    "which": "^3.0.1",
    "ps-tree": "^1.2.0",
    "node-machine-id": "^1.1.12",
    "geoip-lite": "^1.4.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "eslint": "^8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.3",
    "prettier": "^3.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "mini-css-extract-plugin": "^2.7.6",
    "html-webpack-plugin": "^5.5.3",
    "copy-webpack-plugin": "^11.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "webpack-dev-server": "^4.15.1",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "jsdoc": "^4.0.2",
    "jsdoc-to-markdown": "^8.0.0",
    "@types/node": "^20.4.5",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "kill-port": "^2.0.1",
    "detect-port": "^1.5.1",
    "docker-compose": "^0.24.2"
  },
  "peerDependencies": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/config/**",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src/"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "logs/",
      "uploads/",
      "backups/"
    ],
    "delay": 1000
  }
}